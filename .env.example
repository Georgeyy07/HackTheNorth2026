# IMU model calls are server-side. Never put this key in Expo/mobile configuration.
IMU_INFERENCE_ENABLED=true
BASETEN_PREDICT_URL=https://model-qk54002q.api.baseten.co/deployment/woovmmk/predict
BASETEN_API_KEY=

# Set the Tiger PostgreSQL URL here when available (include provider SSL settings).
# DATABASE_URL and TIGER_DATA_URL are also accepted.
IMU_DATABASE_URL=
# For explicit local development only, replace the above with:
# IMU_DATABASE_URL=sqlite:///artifacts/imu_predictions.db

# The saved bias applies to the original car/phone mount. Use none for other cars.
IMU_CALIBRATION_PROFILE=phone_same_car_20260920
